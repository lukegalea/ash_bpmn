<?xml version="1.0" encoding="UTF-8"?>
<!--
  SPDX-FileCopyrightText: 2026 Luke Galea
  SPDX-License-Identifier: MIT

  Refusal-corpus fixture. The offending construct in this document is:
  multiInstanceLoopCharacteristics, nested inside the userTask with id
  "Approval_1". The compiler must refuse the document naming that id and
  construct - not execute the node once as if the marker were absent.
-->
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:ash="https://github.com/lukegalea/ash_bpmn/ns"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_1"
                   targetNamespace="https://github.com/lukegalea/ash_bpmn/ns">
  <bpmn2:process id="Process_refusal" isExecutable="true">
    <bpmn2:startEvent id="Start_1">
      <bpmn2:outgoing>F1</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:userTask id="Approval_1">
      <bpmn2:extensionElements>
        <ash:taskConfig>
          <ash:candidates>
            <ash:candidate kind="role" of="approver"/>
          </ash:candidates>
          <ash:outcomes>
            <ash:outcome name="approved"/>
          </ash:outcomes>
        </ash:taskConfig>
      </bpmn2:extensionElements>
      <bpmn2:multiInstanceLoopCharacteristics id="MI_1" isSequential="false"/>
      <bpmn2:incoming>F1</bpmn2:incoming>
      <bpmn2:outgoing>F2</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:endEvent id="End_1">
      <bpmn2:incoming>F2</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:sequenceFlow id="F1" sourceRef="Start_1" targetRef="Approval_1"/>
    <bpmn2:sequenceFlow id="F2" sourceRef="Approval_1" targetRef="End_1"/>
  </bpmn2:process>
</bpmn2:definitions>
