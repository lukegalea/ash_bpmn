<?xml version="1.0" encoding="UTF-8"?>
<!--
SPDX-FileCopyrightText: 2026 Luke Galea
SPDX-License-Identifier: MIT

Waits for the subject to become something. Every update to that subject re-evaluates the
condition against the record as it now is, and the token wakes the first time it is true.
-->
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:ash="https://github.com/lukegalea/ash_bpmn/ns"
                   id="Definitions_conditional_catch"
                   targetNamespace="https://github.com/lukegalea/ash_bpmn/ns">
  <bpmn2:process id="Process_conditional_catch" name="Conditional catch" isExecutable="true">

    <bpmn2:startEvent id="Start_1"><bpmn2:outgoing>Flow_1</bpmn2:outgoing></bpmn2:startEvent>

    <bpmn2:intermediateCatchEvent id="AwaitFunding" name="Await funding">
      <bpmn2:incoming>Flow_1</bpmn2:incoming>
      <bpmn2:outgoing>Flow_2</bpmn2:outgoing>
      <bpmn2:conditionalEventDefinition id="Cond_1">
        <bpmn2:condition xsi:type="bpmn2:tFormalExpression" language="feel">subject.amount >= 1000</bpmn2:condition>
      </bpmn2:conditionalEventDefinition>
      <bpmn2:extensionElements>
        <ash:subscribe resource="subject"/>
      </bpmn2:extensionElements>
    </bpmn2:intermediateCatchEvent>

    <bpmn2:serviceTask id="Release" name="Release">
      <bpmn2:extensionElements><ash:taskConfig action="release"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_2</bpmn2:incoming>
      <bpmn2:outgoing>Flow_3</bpmn2:outgoing>
    </bpmn2:serviceTask>

    <bpmn2:endEvent id="End_1"><bpmn2:incoming>Flow_3</bpmn2:incoming></bpmn2:endEvent>

    <bpmn2:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="AwaitFunding"/>
    <bpmn2:sequenceFlow id="Flow_2" sourceRef="AwaitFunding" targetRef="Release"/>
    <bpmn2:sequenceFlow id="Flow_3" sourceRef="Release" targetRef="End_1"/>
  </bpmn2:process>
</bpmn2:definitions>
