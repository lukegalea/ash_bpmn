<?xml version="1.0" encoding="UTF-8"?>
<!--
SPDX-FileCopyrightText: 2026 Luke Galea
SPDX-License-Identifier: MIT

A fork where one branch parks on an approval and the other reaches an error end event. The
error ends the whole instance, killing the parked branch, and leaves the instance in a state
that says the process worked exactly as designed and the design says this ends badly.

The bpmn:error declaration sits beside the process, not inside it, which is where BPMN puts
it and the reason the compiler has to read across that boundary at all.
-->
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:ash="https://github.com/lukegalea/ash_bpmn/ns"
                   id="Definitions_error_end"
                   targetNamespace="https://github.com/lukegalea/ash_bpmn/ns">

  <bpmn2:error id="Error_Declined" name="Application declined" errorCode="DECLINED"/>

  <bpmn2:process id="Process_error_end" name="Error end" isExecutable="true">
    <bpmn2:startEvent id="Start_1"><bpmn2:outgoing>Flow_1</bpmn2:outgoing></bpmn2:startEvent>

    <bpmn2:parallelGateway id="Fork_1">
      <bpmn2:incoming>Flow_1</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Approval</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Check</bpmn2:outgoing>
    </bpmn2:parallelGateway>

    <bpmn2:userTask id="SlowApproval" name="Slow approval">
      <bpmn2:extensionElements>
        <ash:taskConfig>
          <ash:candidates><ash:candidate kind="role" of="approver"/></ash:candidates>
          <ash:outcomes><ash:outcome name="approved"/></ash:outcomes>
        </ash:taskConfig>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_Approval</bpmn2:incoming>
      <bpmn2:outgoing>Flow_ApprovalOut</bpmn2:outgoing>
    </bpmn2:userTask>

    <bpmn2:endEvent id="End_ok"><bpmn2:incoming>Flow_ApprovalOut</bpmn2:incoming></bpmn2:endEvent>

    <bpmn2:serviceTask id="CreditCheck" name="Credit check">
      <bpmn2:extensionElements><ash:taskConfig action="credit_check"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_Check</bpmn2:incoming>
      <bpmn2:outgoing>Flow_CheckOut</bpmn2:outgoing>
    </bpmn2:serviceTask>

    <bpmn2:endEvent id="End_declined" name="Declined">
      <bpmn2:extensionElements><ash:taskConfig outcome="declined"/></bpmn2:extensionElements>
      <bpmn2:incoming>Flow_CheckOut</bpmn2:incoming>
      <bpmn2:errorEventDefinition id="ErrDef_1" errorRef="Error_Declined"/>
    </bpmn2:endEvent>

    <bpmn2:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Fork_1"/>
    <bpmn2:sequenceFlow id="Flow_Approval" sourceRef="Fork_1" targetRef="SlowApproval"/>
    <bpmn2:sequenceFlow id="Flow_ApprovalOut" sourceRef="SlowApproval" targetRef="End_ok"/>
    <bpmn2:sequenceFlow id="Flow_Check" sourceRef="Fork_1" targetRef="CreditCheck"/>
    <bpmn2:sequenceFlow id="Flow_CheckOut" sourceRef="CreditCheck" targetRef="End_declined"/>
  </bpmn2:process>
</bpmn2:definitions>
