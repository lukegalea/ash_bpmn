<?xml version="1.0" encoding="UTF-8"?>
<!--
SPDX-FileCopyrightText: 2026 Luke Galea
SPDX-License-Identifier: MIT

Three branches one, two and three nodes long into one parallel join. The node after the
join runs once, after all three.
-->
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xmlns:ash="https://github.com/lukegalea/ash_bpmn/ns"
                   id="Definitions_join_three_branches"
                   targetNamespace="https://github.com/lukegalea/ash_bpmn/ns">
  <bpmn2:process id="Process_join_three_branches" name="Three branches" isExecutable="true">
    <bpmn2:startEvent id="Start_1"><bpmn2:outgoing>F0</bpmn2:outgoing></bpmn2:startEvent>
    <bpmn2:parallelGateway id="Fork_1">
      <bpmn2:incoming>F0</bpmn2:incoming>
      <bpmn2:outgoing>FA</bpmn2:outgoing>
      <bpmn2:outgoing>FB</bpmn2:outgoing>
      <bpmn2:outgoing>FC</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:serviceTask id="A1" name="A1">
      <bpmn2:extensionElements><ash:taskConfig action="a1"/></bpmn2:extensionElements>
      <bpmn2:incoming>FA</bpmn2:incoming>
      <bpmn2:outgoing>FA1</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:serviceTask id="B1" name="B1">
      <bpmn2:extensionElements><ash:taskConfig action="b1"/></bpmn2:extensionElements>
      <bpmn2:incoming>FB</bpmn2:incoming>
      <bpmn2:outgoing>FB1</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:serviceTask id="B2" name="B2">
      <bpmn2:extensionElements><ash:taskConfig action="b2"/></bpmn2:extensionElements>
      <bpmn2:incoming>FB1</bpmn2:incoming>
      <bpmn2:outgoing>FB2</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:serviceTask id="C1" name="C1">
      <bpmn2:extensionElements><ash:taskConfig action="c1"/></bpmn2:extensionElements>
      <bpmn2:incoming>FC</bpmn2:incoming>
      <bpmn2:outgoing>FC1</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:serviceTask id="C2" name="C2">
      <bpmn2:extensionElements><ash:taskConfig action="c2"/></bpmn2:extensionElements>
      <bpmn2:incoming>FC1</bpmn2:incoming>
      <bpmn2:outgoing>FC2</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:serviceTask id="C3" name="C3">
      <bpmn2:extensionElements><ash:taskConfig action="c3"/></bpmn2:extensionElements>
      <bpmn2:incoming>FC2</bpmn2:incoming>
      <bpmn2:outgoing>FC3</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:parallelGateway id="Join_1">
      <bpmn2:incoming>FA1</bpmn2:incoming>
      <bpmn2:incoming>FB2</bpmn2:incoming>
      <bpmn2:incoming>FC3</bpmn2:incoming>
      <bpmn2:outgoing>FJ</bpmn2:outgoing>
    </bpmn2:parallelGateway>
    <bpmn2:serviceTask id="After" name="After">
      <bpmn2:extensionElements><ash:taskConfig action="after_join"/></bpmn2:extensionElements>
      <bpmn2:incoming>FJ</bpmn2:incoming>
      <bpmn2:outgoing>FE</bpmn2:outgoing>
    </bpmn2:serviceTask>
    <bpmn2:endEvent id="End_1"><bpmn2:incoming>FE</bpmn2:incoming></bpmn2:endEvent>

    <bpmn2:sequenceFlow id="F0" sourceRef="Start_1" targetRef="Fork_1"/>
    <bpmn2:sequenceFlow id="FA" sourceRef="Fork_1" targetRef="A1"/>
    <bpmn2:sequenceFlow id="FB" sourceRef="Fork_1" targetRef="B1"/>
    <bpmn2:sequenceFlow id="FC" sourceRef="Fork_1" targetRef="C1"/>
    <bpmn2:sequenceFlow id="FA1" sourceRef="A1" targetRef="Join_1"/>
    <bpmn2:sequenceFlow id="FB1" sourceRef="B1" targetRef="B2"/>
    <bpmn2:sequenceFlow id="FB2" sourceRef="B2" targetRef="Join_1"/>
    <bpmn2:sequenceFlow id="FC1" sourceRef="C1" targetRef="C2"/>
    <bpmn2:sequenceFlow id="FC2" sourceRef="C2" targetRef="C3"/>
    <bpmn2:sequenceFlow id="FC3" sourceRef="C3" targetRef="Join_1"/>
    <bpmn2:sequenceFlow id="FJ" sourceRef="Join_1" targetRef="After"/>
    <bpmn2:sequenceFlow id="FE" sourceRef="After" targetRef="End_1"/>
  </bpmn2:process>
</bpmn2:definitions>
