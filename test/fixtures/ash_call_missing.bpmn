<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:ash="https://github.com/lukegalea/ash_bpmn/ns"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   id="Definitions_ash_call_missing"
                   targetNamespace="https://github.com/lukegalea/ash_bpmn/ns">
  <bpmn2:process id="Process_ash_call_missing" name="ash:call missing required promote" isExecutable="true">

    <bpmn2:startEvent id="Start">
      <bpmn2:outgoing>F_start</bpmn2:outgoing>
    </bpmn2:startEvent>

    <!-- A required signal whose dotted path does not exist in the outputs. That
         is a clean, named failure, never a crash and never a silent skip. -->
    <bpmn2:serviceTask id="AssessMissing" name="Assess with a missing required signal">
      <bpmn2:extensionElements>
        <ash:call ref="AshBpmn.Test.RuntimeCallablesDomain.assess_nested"/>
        <ash:promote>
          <ash:signal name="tier" from="urgent.tier" required="true"/>
        </ash:promote>
      </bpmn2:extensionElements>
      <bpmn2:incoming>F_start</bpmn2:incoming>
      <bpmn2:outgoing>F_assessed</bpmn2:outgoing>
    </bpmn2:serviceTask>

    <bpmn2:endEvent id="EndReviewed">
      <bpmn2:extensionElements><ash:taskConfig outcome="reviewed"/></bpmn2:extensionElements>
      <bpmn2:incoming>F_assessed</bpmn2:incoming>
    </bpmn2:endEvent>

    <bpmn2:sequenceFlow id="F_start" sourceRef="Start" targetRef="AssessMissing"/>
    <bpmn2:sequenceFlow id="F_assessed" sourceRef="AssessMissing" targetRef="EndReviewed"/>
  </bpmn2:process>
</bpmn2:definitions>
