<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                   xmlns:ash="https://github.com/lukegalea/ash_bpmn/ns"
                   id="Definitions_access_request"
                   targetNamespace="https://github.com/lukegalea/ash_bpmn/ns">
  <bpmn2:process id="Process_access_request" name="Privileged access request" isExecutable="true">

    <bpmn2:startEvent id="Start_1" name="Request submitted">
      <bpmn2:outgoing>Flow_1</bpmn2:outgoing>
    </bpmn2:startEvent>

    <bpmn2:serviceTask id="Validate" name="Validate request">
      <bpmn2:extensionElements>
        <ash:taskConfig action="validate_request"/>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_1</bpmn2:incoming>
      <bpmn2:outgoing>Flow_2</bpmn2:outgoing>
    </bpmn2:serviceTask>

    <bpmn2:exclusiveGateway id="PrivilegedGateway" name="Privileged role?" default="Flow_NotPriv">
      <bpmn2:incoming>Flow_2</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Priv</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_NotPriv</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:parallelGateway id="Fork" name="Both reviews">
      <bpmn2:incoming>Flow_Priv</bpmn2:incoming>
      <bpmn2:outgoing>Flow_ForkMgr</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_ForkSec</bpmn2:outgoing>
    </bpmn2:parallelGateway>

    <bpmn2:userTask id="SecurityApproval" name="Security approval">
      <bpmn2:extensionElements>
        <ash:taskConfig>
          <ash:candidates>
            <ash:candidate kind="team" of="security"/>
          </ash:candidates>
          <ash:exclusions>
            <ash:exclusion who="subject.created_by_id"/>
          </ash:exclusions>
          <ash:outcomes>
            <ash:outcome name="approved"/>
            <ash:outcome name="rejected"/>
          </ash:outcomes>
          <ash:timers>
            <ash:timer kind="escalate" hours="24"/>
            <ash:timer kind="expire" days="7"/>
          </ash:timers>
        </ash:taskConfig>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_ForkSec</bpmn2:incoming>
      <bpmn2:outgoing>Flow_SecJoin</bpmn2:outgoing>
    </bpmn2:userTask>

    <bpmn2:userTask id="PrivilegedManagerApproval" name="Manager approval (privileged)">
      <bpmn2:extensionElements>
        <ash:taskConfig>
          <ash:candidates>
            <ash:candidate kind="manager_of" of="subject.created_by_id"/>
          </ash:candidates>
          <ash:exclusions>
            <ash:exclusion who="subject.created_by_id"/>
          </ash:exclusions>
          <ash:outcomes>
            <ash:outcome name="approved"/>
            <ash:outcome name="rejected"/>
          </ash:outcomes>
        </ash:taskConfig>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_ForkMgr</bpmn2:incoming>
      <bpmn2:outgoing>Flow_MgrJoin</bpmn2:outgoing>
    </bpmn2:userTask>

    <bpmn2:parallelGateway id="Join" name="Both approved">
      <bpmn2:incoming>Flow_MgrJoin</bpmn2:incoming>
      <bpmn2:incoming>Flow_SecJoin</bpmn2:incoming>
      <bpmn2:outgoing>Flow_JoinProvision</bpmn2:outgoing>
    </bpmn2:parallelGateway>

    <bpmn2:userTask id="ManagerApproval" name="Manager approval">
      <bpmn2:extensionElements>
        <ash:taskConfig>
          <ash:candidates>
            <ash:candidate kind="manager_of" of="subject.created_by_id"/>
          </ash:candidates>
          <ash:exclusions>
            <ash:exclusion who="subject.created_by_id"/>
          </ash:exclusions>
          <ash:outcomes>
            <ash:outcome name="approved"/>
            <ash:outcome name="rejected"/>
          </ash:outcomes>
          <ash:timers>
            <ash:timer kind="escalate" hours="24"/>
            <ash:timer kind="expire" days="7"/>
          </ash:timers>
        </ash:taskConfig>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_NotPriv</bpmn2:incoming>
      <bpmn2:outgoing>Flow_MgrDecision</bpmn2:outgoing>
    </bpmn2:userTask>

    <bpmn2:exclusiveGateway id="DecisionGateway" name="Approved?" default="Flow_Rejected">
      <bpmn2:incoming>Flow_MgrDecision</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Approved</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_Rejected</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>

    <bpmn2:serviceTask id="Provision" name="Provision access">
      <bpmn2:extensionElements>
        <ash:taskConfig action="provision_access"/>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_Approved</bpmn2:incoming>
      <bpmn2:incoming>Flow_JoinProvision</bpmn2:incoming>
      <bpmn2:outgoing>Flow_Granted</bpmn2:outgoing>
    </bpmn2:serviceTask>

    <bpmn2:endEvent id="End_granted" name="Access granted">
      <bpmn2:extensionElements>
        <ash:taskConfig outcome="granted"/>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_Granted</bpmn2:incoming>
    </bpmn2:endEvent>

    <bpmn2:endEvent id="End_rejected" name="Request rejected">
      <bpmn2:extensionElements>
        <ash:taskConfig outcome="rejected"/>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_Rejected</bpmn2:incoming>
    </bpmn2:endEvent>

    <bpmn2:sequenceFlow id="Flow_1" sourceRef="Start_1" targetRef="Validate"/>
    <bpmn2:sequenceFlow id="Flow_2" sourceRef="Validate" targetRef="PrivilegedGateway"/>
    <bpmn2:sequenceFlow id="Flow_Priv" name="privileged" sourceRef="PrivilegedGateway" targetRef="Fork">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression"
                                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">subject.is_privileged = true</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_NotPriv" name="standard" sourceRef="PrivilegedGateway" targetRef="ManagerApproval"/>
    <bpmn2:sequenceFlow id="Flow_ForkMgr" sourceRef="Fork" targetRef="PrivilegedManagerApproval"/>
    <bpmn2:sequenceFlow id="Flow_ForkSec" sourceRef="Fork" targetRef="SecurityApproval"/>
    <bpmn2:sequenceFlow id="Flow_MgrJoin" sourceRef="PrivilegedManagerApproval" targetRef="Join"/>
    <bpmn2:sequenceFlow id="Flow_SecJoin" sourceRef="SecurityApproval" targetRef="Join"/>
    <bpmn2:sequenceFlow id="Flow_JoinProvision" sourceRef="Join" targetRef="Provision"/>
    <bpmn2:sequenceFlow id="Flow_MgrDecision" sourceRef="ManagerApproval" targetRef="DecisionGateway"/>
    <bpmn2:sequenceFlow id="Flow_Approved" name="approved" sourceRef="DecisionGateway" targetRef="Provision">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression"
                                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">task.outcome = "approved"</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_Rejected" name="rejected" sourceRef="DecisionGateway" targetRef="End_rejected"/>
    <bpmn2:sequenceFlow id="Flow_Granted" sourceRef="Provision" targetRef="End_granted"/>
  </bpmn2:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_access_request">
      <bpmndi:BPMNShape id="Shape_Start_1" bpmnElement="Start_1">
        <dc:Bounds x="152" y="322" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="128" y="365" width="85" height="27"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Validate" bpmnElement="Validate">
        <dc:Bounds x="240" y="300" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PrivilegedGateway" bpmnElement="PrivilegedGateway" isMarkerVisible="true">
        <dc:Bounds x="395" y="315" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="380" y="272" width="81" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Fork" bpmnElement="Fork">
        <dc:Bounds x="505" y="155" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="495" y="212" width="71" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_PrivilegedManagerApproval" bpmnElement="PrivilegedManagerApproval">
        <dc:Bounds x="620" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SecurityApproval" bpmnElement="SecurityApproval">
        <dc:Bounds x="620" y="200" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Join" bpmnElement="Join">
        <dc:Bounds x="790" y="155" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="777" y="212" width="77" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ManagerApproval" bpmnElement="ManagerApproval">
        <dc:Bounds x="530" y="420" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DecisionGateway" bpmnElement="DecisionGateway" isMarkerVisible="true">
        <dc:Bounds x="695" y="435" width="50" height="50"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="694" y="492" width="53" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Provision" bpmnElement="Provision">
        <dc:Bounds x="900" y="300" width="100" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_granted" bpmnElement="End_granted">
        <dc:Bounds x="1062" y="322" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1042" y="365" width="78" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_rejected" bpmnElement="End_rejected">
        <dc:Bounds x="1062" y="442" width="36" height="36"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1038" y="485" width="86" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="188" y="340"/>
        <di:waypoint x="240" y="340"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="340" y="340"/>
        <di:waypoint x="395" y="340"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Priv" bpmnElement="Flow_Priv">
        <di:waypoint x="420" y="315"/>
        <di:waypoint x="420" y="180"/>
        <di:waypoint x="505" y="180"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="428" y="240" width="58" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_NotPriv" bpmnElement="Flow_NotPriv">
        <di:waypoint x="420" y="365"/>
        <di:waypoint x="420" y="460"/>
        <di:waypoint x="530" y="460"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="428" y="418" width="48" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ForkMgr" bpmnElement="Flow_ForkMgr">
        <di:waypoint x="530" y="155"/>
        <di:waypoint x="530" y="120"/>
        <di:waypoint x="620" y="120"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_ForkSec" bpmnElement="Flow_ForkSec">
        <di:waypoint x="530" y="205"/>
        <di:waypoint x="530" y="240"/>
        <di:waypoint x="620" y="240"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_MgrJoin" bpmnElement="Flow_MgrJoin">
        <di:waypoint x="720" y="120"/>
        <di:waypoint x="815" y="120"/>
        <di:waypoint x="815" y="155"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_SecJoin" bpmnElement="Flow_SecJoin">
        <di:waypoint x="720" y="240"/>
        <di:waypoint x="815" y="240"/>
        <di:waypoint x="815" y="205"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_JoinProvision" bpmnElement="Flow_JoinProvision">
        <di:waypoint x="840" y="180"/>
        <di:waypoint x="950" y="180"/>
        <di:waypoint x="950" y="300"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_MgrDecision" bpmnElement="Flow_MgrDecision">
        <di:waypoint x="630" y="460"/>
        <di:waypoint x="695" y="460"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Approved" bpmnElement="Flow_Approved">
        <di:waypoint x="720" y="435"/>
        <di:waypoint x="720" y="340"/>
        <di:waypoint x="900" y="340"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="728" y="380" width="55" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Rejected" bpmnElement="Flow_Rejected">
        <di:waypoint x="745" y="460"/>
        <di:waypoint x="1062" y="460"/>
        <bpmndi:BPMNLabel>
          <dc:Bounds x="880" y="438" width="50" height="14"/>
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Granted" bpmnElement="Flow_Granted">
        <di:waypoint x="1000" y="340"/>
        <di:waypoint x="1062" y="340"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>
